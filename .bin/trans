#!/usr/bin/env sh
# vim:ft=sh:et:ts=4:sw=4:sts=4:
#
# Translate text using a pluggable LLM backend.
#
# Usage:
#   trans [options] [text...]
#   echo "hello" | trans -
#   trans --to zh "hello world"
#   trans --stream "hello world"
#   trans --backend pi --model qoder/Qwen3.8-Flash "hello world"
#
# Environment:
#   TRANSLATE_BACKEND   Backend: curl (default) or pi
#   TRANSLATE_API_BASE  API base URL (curl backend)
#   TRANSLATE_API_KEY   API key (curl backend)
#   TRANSLATE_MODEL     Model name, backend specific
#   TRANSLATE_TO        Default target language
#   TRANSLATE_PAIR      Default language pair
#
# Backends:
#   A backend <name> is a pair of functions sharing the globals `text`,
#   `model` and `stream`:
#
#   <name>_check
#       Validate backend-specific config. Call `die` on error.
#
#   <name>_translate SYSTEM_PROMPT
#       Translate $text using $model. Print only the translation to stdout,
#       ending with a newline. Stream as it arrives when $stream is 1.
#       Exit non-zero on failure.
#
#   The benefit of supporting other backend besides curl is that it enables us
#   to use LLM subscriptions. E.g. with the pi backend + pi-provider-qoder
#   extension, we can use the Qoder subscription logged in to Pi. The reason
#   why we choose Pi over QoderCLI is the startup speed.

set -eu

# Space-separated; each name needs `<name>_check` and `<name>_translate`.
TRANSLATE_SUPPORTED_BACKENDS='curl pi'

usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [text...]

Translate text using a pluggable LLM backend.

Options:
    -B, --backend NAME Underlying backend for translation  (default: \$TRANSLATE_BACKEND,  or curl)
    -b, --base URL     API base URL                        (default: \$TRANSLATE_API_BASE, curl only, e.g. https://api.deepseek.com)
    -k, --key KEY      API key                             (default: \$TRANSLATE_API_KEY,  curl only, e.g. \$DEEPSEEK_API_KEY)
    -m, --model NAME   Model name                          (default: \$TRANSLATE_MODEL,    e.g. deepseek-chat, qoder/Qwen3.8-Flash)
    -t, --to LANG      Target language                     (default: \$TRANSLATE_TO,       e.g. Chinese)
    -p, --pair LANGS   Language pair                       (default: \$TRANSLATE_PAIR,     e.g. English:Chinese)
    -s, --stream       Stream the response
    -                  Read text from stdin
    -h, --help         Show this help message and exit
EOF
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

# $1: backend name
is_supported_backend() {
    for name in $TRANSLATE_SUPPORTED_BACKENDS; do
        if [ "$name" = "$1" ]; then return 0; fi
    done
    return 1
}

# $@: args from command line
parse_args() {
    backend="${TRANSLATE_BACKEND:-curl}"
    api_base="${TRANSLATE_API_BASE:-}"
    api_key="${TRANSLATE_API_KEY:-}"
    model="${TRANSLATE_MODEL:-}"
    target_lang="${TRANSLATE_TO:-}"

    pair="${TRANSLATE_PAIR:-}"
    stream=0
    use_stdin=0

    while [ $# -gt 0 ]; do
        case "$1" in
        -t | --to)
            target_lang="$2"
            pair=''  # `--to` takes precedence over `--pair`
            shift 2
            ;;
        -m | --model)
            model="$2"
            shift 2
            ;;
        -B | --backend)
            backend="$2"
            shift 2
            ;;
        -k | --key)
            api_key="$2"
            shift 2
            ;;
        -b | --base)
            api_base="$2"
            shift 2
            ;;
        -p | --pair)
            pair="$2"
            shift 2
            ;;
        -s | --stream)
            stream=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -)
            use_stdin=1
            shift
            ;;
        -*)
            usage >&2
            exit 1
            ;;
        *) break ;;
        esac
    done

    is_supported_backend "$backend" ||
        die "Unknown backend '$backend'. Use one of: $TRANSLATE_SUPPORTED_BACKENDS"

    if [ -z "$model" ]; then die "No model set. Use -m or set TRANSLATE_MODEL."; fi
    if [ -z "$pair" ] && [ -z "$target_lang" ]; then
        die "No target language set. Use -t or set TRANSLATE_TO, or use -p for a language pair."
    fi

    if [ -n "$pair" ]; then
        pair_lang1="${pair%%:*}"
        pair_lang2="${pair##*:}"
        if [ -z "$pair_lang1" ] || [ -z "$pair_lang2" ] || [ "$pair_lang1" = "$pair_lang2" ]; then
            die "Invalid language pair '$pair'. Use format: LANG1:LANG2 (e.g. English:Chinese)"
        fi
    fi

    if [ "$use_stdin" -eq 1 ]; then
        text=$(cat)
    elif [ $# -gt 0 ]; then
        text="$*"
    else
        die "No text provided. Pass as arguments or use - to read from stdin."
    fi
    text=$(printf '%s' "$text" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

    if [ -z "$text" ]; then
        die "Empty input."
    fi
}

build_system_prompt() {
    if [ -n "$pair" ]; then
        printf '%s' "You are a translator. If the text is mainly in $pair_lang1, translate to $pair_lang2. If it's mainly in $pair_lang2, translate to $pair_lang1. Output only the translation, nothing else."
    else
        printf '%s' "You are a translator. Translate the following text to $target_lang. Output only the translation, nothing else."
    fi
}

# Backend: any OpenAI-compatible chat completions API, queried with curl.

curl_check() {
    if [ -z "$api_base" ]; then die "No API base URL set. Use -b or set TRANSLATE_API_BASE."; fi
    if [ -z "$api_key" ]; then die "No API key found, set TRANSLATE_API_KEY."; fi
}

# $1: system prompt
curl_translate() {
    payload=$(jq -nc \
        --arg model "$model" \
        --arg system "$1" \
        --arg text "$text" \
        --argjson stream "$stream" \
        '{
            model: $model,
            messages: [
                {role: "system", content: $system},
                {role: "user",   content: $text}
            ],
            temperature: 0.3
        } + if $stream == 1 then {stream: true} else {} end')

    if [ "$stream" -eq 1 ]; then
        curl_stream
        return
    fi

    if ! response=$(curl_request); then
        die "API request failed: $response"
    fi

    translation=$(printf '%s' "$response" | jq -r '.choices[0].message.content // empty')
    if [ -z "$translation" ]; then
        error=$(printf '%s' "$response" | jq -r '.error.message // empty')
        die "Translation failed: ${error:-unknown error}"
    fi
    printf '%s\n' "$translation"
}

# Print deltas of the server-sent event stream for $payload. Errors arrive as
# an SSE event with `.error`, or as a plain body instead of the stream.
curl_stream() {
    curl_request -N --no-buffer | {
        error=''
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
            "data: [DONE]" | "data:[DONE]") break ;;
            data:*)
                printf '%s' "${line#data:}" | jq -rj '
                    if .error then
                        "\nAPI request failed: \(.error.message // .error)\n" | halt_error(1)
                    else
                        .choices[0].delta.content // empty
                    end'
                ;;
            '' | :* | event:* | id:* | retry:*) ;;
            *) error="$error$line" ;;
            esac
        done
        printf '\n'
        if [ -n "$error" ]; then die "API request failed: $error"; fi
    }
}

# $@: extra curl options
curl_request() {
    curl -sS --fail-with-body "$@" \
        "$api_base/chat/completions" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $api_key" \
        -d "$payload"
}

# Backend: pi coding agent, using whatever provider auth pi has (e.g. a
# Qoder subscription). $model is a pi model pattern like qoder/Qwen3.8-Flash.

pi_check() {
    command -v pi >/dev/null || die "pi not found in PATH."
}

# $1: system prompt
pi_translate() {
    if [ "$stream" -eq 0 ]; then
        pi_run "$1" -p
        return
    fi
    # `pi --mode json` exits 0 even on failure and reports errors in events.
    # Fail only at end of input, so pi never writes into a closed pipe.
    pi_run "$1" --mode json | jq -nrj --unbuffered '
        foreach (inputs, {type: "eof"}) as $e (null;
            if $e.type == "message_end" and $e.message.stopReason == "error" then
                $e.message.errorMessage
            end;
            if $e.type == "message_update" and $e.assistantMessageEvent.type == "text_delta" then
                $e.assistantMessageEvent.delta
            elif $e.type == "eof" and . != null then
                "\n\(.)\n" | halt_error(1)
            else
                empty
            end)'
    printf '\n'
}

# $1: system prompt, rest: output mode options
pi_run() {
    system="$1"
    shift
    printf '%s' "$text" | pi "$@" --no-session --no-tools -nc -ns -np \
        --thinking off --model "$model" --system-prompt "$system"
}

main() {
    parse_args "$@"
    "${backend}_check"
    "${backend}_translate" "$(build_system_prompt)"
}

main "$@"

{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.mjs",
      "**/*.json",
      "!sessions",
      "!missions",
      "!npm",
      "!node_modules",
      "!*-cache.json",
      "!models-store.json",
      "!auth.json",
      "!mcp-auth.json",
      "!settings.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["extensions/**"],
      "linter": { "rules": { "nursery": { "noFloatingPromises": "error" } } }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": { "suspicious": { "noControlCharactersInRegex": "off" } }
      }
    }
  ]
}

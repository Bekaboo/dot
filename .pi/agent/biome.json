{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.json",
      "!sessions",
      "!missions",
      "!npm",
      "!node_modules",
      "!*-cache.json",
      "!models-store.json",
      "!auth.json",
      "!mcp-auth.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
